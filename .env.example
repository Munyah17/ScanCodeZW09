# ─────────────────────────────────────────────────────────────────
# ScanCodeZW  —  Environment variables
# Copy this file to .env.local for local overrides (never commit .env.local)
# ─────────────────────────────────────────────────────────────────

# ── Stripe ───────────────────────────────────────────────────────
# Publishable key  (safe in browser, prefix: pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Secret key  (server-side only — NEVER expose to browser, prefix: sk_)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret  (from Stripe Dashboard → Webhooks, prefix: whsec_)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Paynow ───────────────────────────────────────────────────────
# Integration ID  (numeric, from Paynow Merchant Dashboard → Integrations)
PAYNOW_INTEGRATION_ID=REPLACE_ME

# Integration Key  (long hex string from the same page)
PAYNOW_INTEGRATION_KEY=REPLACE_ME

# ── Stripe redirect URLs ─────────────────────────────────────────
# Browser lands here after Stripe Checkout succeeds
STRIPE_SUCCESS_URL=http://localhost:3000/payment/return
# Browser lands here if user abandons Stripe Checkout
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Return URL shown to user after web payment (not used for mobile money)
PAYNOW_RETURN_URL=http://localhost:3000/payment/return

# Result URL  —  Paynow POSTs payment status here (must be publicly reachable)
# For local dev use ngrok: ngrok http 3000  →  paste the https URL here
PAYNOW_RESULT_URL=http://localhost:3000/api/paynow/callback

# ── Supabase ─────────────────────────────────────────────────────
# Project URL  (from Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Anon / public key  (safe in browser)
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key  (server-side only — full DB access, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── App ──────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
APP_URL=http://localhost:3000

# ── External Credentials Encryption ─────────────────────────────
# AES-256-GCM key used to encrypt partner/client API keys stored in external_credentials table.
# Must be at least 32 characters. Change this in production and keep it secret.
EXTERNAL_CREDS_SECRET=change-me-to-a-random-32-char-string
