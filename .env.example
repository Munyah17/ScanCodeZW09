# ─────────────────────────────────────────────────────────────────
# ScanCodeZW  —  Environment variables template
# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is gitignored.
# Production values are stored in Vercel project settings (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────

# ── Stripe ───────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── Paynow ───────────────────────────────────────────────────────
PAYNOW_INTEGRATION_ID=REPLACE_ME
PAYNOW_INTEGRATION_KEY=REPLACE_ME
PAYNOW_MERCHANT_NAME=REPLACE_ME

# ── Stripe redirect URLs ─────────────────────────────────────────
STRIPE_SUCCESS_URL=https://scancode.co.zw/payment/return
STRIPE_CANCEL_URL=https://scancode.co.zw/payment/cancel

# ── Paynow redirect URLs ─────────────────────────────────────────
PAYNOW_RETURN_URL=https://scancode.co.zw/payment/return
PAYNOW_RESULT_URL=https://scancode.co.zw/api/paynow/callback

# ── Supabase ─────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ── App ──────────────────────────────────────────────────────────
VITE_APP_URL=https://scancode.co.zw
APP_URL=https://scancode.co.zw

# ── External Credentials Encryption ─────────────────────────────
EXTERNAL_CREDS_SECRET=REPLACE_ME_32_CHAR_RANDOM_STRING
